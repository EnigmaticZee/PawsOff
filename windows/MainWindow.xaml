<Window x:Class="PawsOff.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paws Off" Width="380" Height="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" Foreground="White"
        Icon="Assets/PawsOff.ico"
        UseLayoutRounding="True">

    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe MDL2 Assets</FontFamily>

        <!-- Paw print: four toes and a pad, drawn so it needs no icon font. -->
        <GeometryGroup x:Key="PawGeometry" FillRule="Nonzero">
            <EllipseGeometry Center="19,40" RadiusX="9" RadiusY="11.5" />
            <EllipseGeometry Center="37,21" RadiusX="9.5" RadiusY="12.5" />
            <EllipseGeometry Center="63,21" RadiusX="9.5" RadiusY="12.5" />
            <EllipseGeometry Center="81,40" RadiusX="9" RadiusY="11.5" />
            <EllipseGeometry Center="50,70" RadiusX="23" RadiusY="19" />
        </GeometryGroup>

        <LinearGradientBrush x:Key="LockedGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#5CEBC7" Offset="0" />
            <GradientStop Color="#3394FA" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="Plain" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Capsule" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="#8CFFFFFF" />
            <Setter Property="Background" Value="#0DFFFFFF" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="#80FFFFFF" />
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Width="40" Height="34" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel Background="Transparent" LastChildFill="True">
                            <Border x:Name="Track" DockPanel.Dock="Right" Width="38" Height="22" CornerRadius="11"
                                    Background="#24FFFFFF" VerticalAlignment="Top" Margin="12,0,0,0">
                                <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="2,0" />
                            </Border>
                            <ContentPresenter />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource LockedGradient}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#E6FFFFFF" />
        </Style>
        <Style x:Key="SettingDetail" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#80FFFFFF" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Width="380" Height="620">
        <Grid.Clip>
            <RectangleGeometry Rect="0,0,380,620" RadiusX="14" RadiusY="14" />
        </Grid.Clip>

        <!-- Background: the same dark gradient and two soft glows as the Mac app. -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0F0F1A" Offset="0" />
                    <GradientStop Color="#1A1429" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Canvas IsHitTestVisible="False">
            <Ellipse x:Name="Glow1" Width="320" Height="320" Canvas.Left="-60" Canvas.Top="20" Opacity="0.35">
                <Ellipse.Effect>
                    <BlurEffect Radius="140" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse x:Name="Glow2" Width="300" Height="300" Canvas.Left="150" Canvas.Top="300" Opacity="0.35">
                <Ellipse.Effect>
                    <BlurEffect Radius="140" />
                </Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar: drag anywhere; settings, minimize, close to tray. -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnDrag">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" Opacity="0.5">
                    <Path Data="{StaticResource PawGeometry}" Fill="White" Width="12" Height="12" Stretch="Uniform" />
                    <TextBlock Text="Paws Off" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SettingsButton" Style="{StaticResource TitleButton}" Content="&#xE713;" FontSize="13" Click="OnSettings" ToolTip="Settings" />
                    <Button Style="{StaticResource TitleButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimize" />
                    <Button Style="{StaticResource TitleButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="Close to the tray" />
                </StackPanel>
            </Grid>

            <!-- Clean / Away switch -->
            <Border Grid.Row="1" x:Name="ModePicker" HorizontalAlignment="Center" Margin="0,10,0,0" Padding="4"
                    CornerRadius="20" Background="#0FFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="CleanTab" Style="{StaticResource Capsule}" Padding="16,6" FontSize="12" Click="OnCleanTab">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE765;" FontSize="12" VerticalAlignment="Center" Margin="0,1,7,0" />
                            <TextBlock Text="Clean" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AwayTab" Style="{StaticResource Capsule}" Padding="16,6" FontSize="12" Margin="4,0,0,0" Click="OnAwayTab">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource PawGeometry}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Away" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="2" x:Name="StatusLabel" HorizontalAlignment="Center" Margin="0,20,0,0"
                       FontSize="11" FontWeight="SemiBold" Foreground="#8CFFFFFF" />

            <!-- The big glowing button -->
            <Button Grid.Row="3" x:Name="BigButton" Style="{StaticResource Plain}" Click="OnBigButton"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseEnter="OnBigButtonHover" MouseLeave="OnBigButtonHover">
                <Grid Width="240" Height="240" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="BigScale" />
                    </Grid.RenderTransform>
                    <Ellipse x:Name="Halo" Width="214" Height="214" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="HaloScale" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="RingTrack" Width="212" Height="212" Stroke="#14FFFFFF" StrokeThickness="3" Visibility="Collapsed" />
                    <Ellipse x:Name="Ring" Width="212" Height="212" StrokeThickness="3" StrokeDashCap="Round"
                             Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="-90" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="Disc" Width="190" Height="190">
                        <Ellipse.Effect>
                            <DropShadowEffect x:Name="DiscShadow" BlurRadius="60" ShadowDepth="14" Direction="270" Opacity="0.55" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <Ellipse Width="168" Height="168" Stroke="#2EFFFFFF" StrokeThickness="1">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#4D1A1429" Offset="0" />
                                <GradientStop Color="#661A1429" Offset="1" />
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="KeyboardGlyph" FontFamily="{StaticResource Icons}" Text="&#xE765;" FontSize="54" HorizontalAlignment="Center" />
                        <Path x:Name="PawGlyph" Data="{StaticResource PawGeometry}" Fill="White" Width="50" Height="50" Stretch="Uniform" HorizontalAlignment="Center" />
                        <TextBlock x:Name="ButtonLabel" FontSize="12" FontWeight="Bold" Foreground="#D9FFFFFF" HorizontalAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </Button>

            <StackPanel Grid.Row="4" Margin="24,0">
                <TextBlock x:Name="TitleText" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock x:Name="SubtitleText" FontSize="13" Foreground="#99FFFFFF" TextWrapping="Wrap" TextAlignment="Center"
                           MaxWidth="300" Margin="0,8,0,0" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Detail row: timer chips (Clean), unlock phrase (Away) or live info (locked). -->
            <Grid Grid.Row="5" Height="34" Margin="0,16,0,0">
                <StackPanel x:Name="TimerChips" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE916;" FontSize="12" Foreground="#73FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button Tag="0" Content="No timer" Style="{StaticResource Capsule}" Click="OnChip" />
                    <Button Tag="30" Content="30 s" Style="{StaticResource Capsule}" Margin="6,0,0,0" Click="OnChip" />
                    <Button Tag="60" Content="1 min" Style="{StaticResource Capsule}" Margin="6,0,0,0" Click="OnChip" />
                    <Button Tag="120" Content="2 min" Style="{StaticResource Capsule}" Margin="6,0,0,0" Click="OnChip" />
                </StackPanel>
                <Button x:Name="PhraseRow" Style="{StaticResource Plain}" Click="OnSettings" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE765;" FontSize="12" Foreground="#A6FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Unlock phrase" FontSize="12" Foreground="#A6FFFFFF" VerticalAlignment="Center" />
                        <Border Background="#1AFFFFFF" CornerRadius="6" Padding="8,3" Margin="8,0">
                            <TextBlock x:Name="PhraseText" FontFamily="Consolas" FontWeight="SemiBold" FontSize="12" />
                        </Border>
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE70F;" FontSize="11" Foreground="#66FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border x:Name="LockedInfo" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="16"
                        Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="14,7">
                    <TextBlock x:Name="LockedInfoText" FontSize="12" FontWeight="Medium" Foreground="#BFFFFFFF" />
                </Border>
            </Grid>

            <Grid Grid.Row="6" Margin="24,12,24,20" MinHeight="44">
                <TextBlock x:Name="HintText" FontSize="11" Foreground="#66FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border x:Name="SummaryCard" HorizontalAlignment="Center" CornerRadius="14" Background="#12FFFFFF"
                        BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="16,9">
                    <StackPanel>
                        <TextBlock x:Name="SummaryHeadline" FontSize="12" FontWeight="SemiBold" Foreground="#D9FFFFFF" HorizontalAlignment="Center" />
                        <TextBlock x:Name="SummaryDetail" FontSize="11" Foreground="#80FFFFFF" HorizontalAlignment="Center" Margin="0,3,0,0" />
                        <TextBlock x:Name="SummaryReason" FontSize="11" Foreground="#80FFFFFF" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Settings panel -->
        <Grid x:Name="SettingsOverlay" Visibility="Collapsed" Background="#B3000000">
            <Border Width="336" VerticalAlignment="Center" CornerRadius="16" Padding="24" BorderBrush="#24FFFFFF" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1A1429" Offset="0" />
                        <GradientStop Color="#0F0F1A" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" />

                    <TextBlock Text="Unlock phrase" Style="{StaticResource SettingTitle}" Margin="0,20,0,0" />
                    <TextBlock Style="{StaticResource SettingDetail}" Margin="0,3,0,10"
                               Text="Type it while locked to release the keyboard. Pets can't spell. Letters and numbers only; leave it empty to unlock by clicking." />
                    <Border CornerRadius="10" Background="#14FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" Padding="10,7">
                        <TextBox x:Name="PhraseBox" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                                 FontFamily="Consolas" FontSize="13" MaxLength="24" TextChanged="OnPhraseChanged" />
                    </Border>

                    <CheckBox x:Name="PawSwitch" Style="{StaticResource Switch}" Margin="0,22,0,0" Click="OnPawSwitch">
                        <StackPanel>
                            <TextBlock Text="Paw detection" Style="{StaticResource SettingTitle}" />
                            <TextBlock Style="{StaticResource SettingDetail}"
                                       Text="Locks by itself when several keys are pressed at once or held down, like a cat walking or sitting on the keyboard." />
                        </StackPanel>
                    </CheckBox>

                    <CheckBox x:Name="LoginSwitch" Style="{StaticResource Switch}" Margin="0,18,0,0" Click="OnLoginSwitch">
                        <StackPanel>
                            <TextBlock Text="Launch at sign-in" Style="{StaticResource SettingTitle}" />
                            <TextBlock Style="{StaticResource SettingDetail}"
                                       Text="Starts quietly in the tray when you sign in, so the shortcut and paw detection are always ready." />
                        </StackPanel>
                    </CheckBox>

                    <DockPanel Margin="0,18,0,0">
                        <Border DockPanel.Dock="Right" CornerRadius="6" Background="#1AFFFFFF" BorderBrush="#29FFFFFF" BorderThickness="1"
                                Padding="8,4" VerticalAlignment="Top" Margin="12,0,0,0">
                            <TextBlock x:Name="ShortcutText" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Shortcut" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Locks and unlocks from anywhere." Style="{StaticResource SettingDetail}" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Margin="0,24,0,0">
                        <Button DockPanel.Dock="Right" Content="Done" Style="{StaticResource Capsule}" Padding="18,8" FontSize="12"
                                Foreground="White" Background="#1FFFFFFF" BorderBrush="#33FFFFFF" Click="OnSettingsDone" />
                        <TextBlock x:Name="CreditText" FontSize="11" Foreground="#66FFFFFF" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Hairline window edge -->
        <Border CornerRadius="14" BorderBrush="#24FFFFFF" BorderThickness="1" IsHitTestVisible="False" />
    </Grid>
</Window>
