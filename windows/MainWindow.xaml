<Window x:Class="PawsOff.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paws Off" Width="320" Height="466"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}"
        Icon="Assets/PawsOff.ico"
        UseLayoutRounding="True">

    <!-- A slim title row (drag, minimize, close to the tray) above the shared card. -->
    <Grid x:Name="RootGrid" Width="320" Height="466">
        <Grid.Clip>
            <RectangleGeometry Rect="0,0,320,466" RadiusX="8" RadiusY="8" />
        </Grid.Clip>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Rectangle Grid.RowSpan="2" Fill="{DynamicResource WindowBackground}" />

        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnDrag">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Path Data="{StaticResource PawGeometry}" Fill="{DynamicResource TextMuted}" Width="12" Height="12" Stretch="Uniform" />
                <TextBlock Text="Paws Off" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="7,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimize" />
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="Close to the tray" />
            </StackPanel>
        </Grid>

        <ContentControl x:Name="CardHost" Grid.Row="1" />

        <!-- Hairline window edge -->
        <Border Grid.RowSpan="2" CornerRadius="8" BorderBrush="{DynamicResource Stroke2}" BorderThickness="1" IsHitTestVisible="False" />
    </Grid>
</Window>
