<UserControl x:Class="PawsOff.CardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="320" Height="430"
             FontFamily="{StaticResource AppFont}"
             Foreground="{DynamicResource TextBody}"
             UseLayoutRounding="True">

    <!-- The whole app UI as one compact card, shown in the app window and in the tray pop-up.
         Settings slide in inside it, at the same size. Mirrors Sources/CardView.swift on the Mac. -->
    <Grid x:Name="RootGrid" ClipToBounds="True">
        <Rectangle Fill="{DynamicResource WindowBackground}" MouseLeftButtonDown="OnBackgroundClick" />
        <Canvas IsHitTestVisible="False">
            <Ellipse x:Name="Glow1" Width="460" Height="460" Canvas.Left="-160" Canvas.Top="-130" />
            <Ellipse x:Name="Glow2" Width="440" Height="440" Canvas.Left="20" Canvas.Top="120" />
        </Canvas>

        <Grid x:Name="MainPage">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Clean / Away switch -->
            <Border Grid.Row="0" x:Name="ModePicker" HorizontalAlignment="Center" Margin="0,16,0,0" Padding="3"
                    CornerRadius="17" Background="{DynamicResource Fill1}" BorderBrush="{DynamicResource Stroke1}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="CleanTab" Style="{StaticResource Capsule}" Padding="14,5" FontSize="12" Click="OnCleanTab">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource SparkleGeometry}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Clean" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AwayTab" Style="{StaticResource Capsule}" Padding="14,5" FontSize="12" Margin="3,0,0,0" Click="OnAwayTab">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource PawGeometry}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Away" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- The big glowing button -->
            <Button Grid.Row="2" x:Name="BigButton" Style="{StaticResource Plain}" Click="OnBigButton"
                    HorizontalAlignment="Center" MouseEnter="OnBigButtonHover" MouseLeave="OnBigButtonHover">
                <Grid Width="190" Height="190" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="BigScale" />
                    </Grid.RenderTransform>
                    <Ellipse x:Name="Halo" Width="166" Height="166" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="HaloScale" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="RingTrack" Width="164" Height="164" Stroke="{DynamicResource Fill2}" StrokeThickness="3" Visibility="Collapsed" />
                    <Ellipse x:Name="Ring" Width="164" Height="164" StrokeThickness="3" StrokeDashCap="Round"
                             Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="-90" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="Disc" Width="148" Height="148">
                        <Ellipse.Effect>
                            <DropShadowEffect x:Name="DiscShadow" BlurRadius="44" ShadowDepth="10" Direction="270" Opacity="0.55" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <Ellipse Width="130" Height="130" Fill="{DynamicResource GlassFill}" />
                    <Ellipse Width="130" Height="130" Fill="{DynamicResource GlassHighlight}" />
                    <Ellipse Width="130" Height="130" Stroke="#38FFFFFF" StrokeThickness="1" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="KeyboardGlyph" FontFamily="{StaticResource Icons}" Text="&#xE765;" FontSize="40"
                                   Foreground="White" HorizontalAlignment="Center" />
                        <Path x:Name="PawGlyph" Data="{StaticResource PawGeometry}" Fill="White" Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" />
                        <TextBlock x:Name="ButtonLabel" FontSize="11" FontWeight="Bold" Foreground="#E6FFFFFF" HorizontalAlignment="Center" Margin="0,7,0,0" />
                    </StackPanel>
                </Grid>
            </Button>

            <StackPanel Grid.Row="3" Margin="20,0">
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
                <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center"
                           LineHeight="17" MaxWidth="270" Margin="0,4,0,0" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Timer chips (Clean), unlock phrase (Away) or live info (locked). -->
            <Grid Grid.Row="4" Height="30" Margin="0,14,0,0">
                <StackPanel x:Name="TimerChips" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE916;" FontSize="12" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button Tag="0" Content="No timer" Style="{StaticResource Capsule}" Click="OnChip" />
                    <Button Tag="30" Content="30 s" Style="{StaticResource Capsule}" Margin="5,0,0,0" Click="OnChip" />
                    <Button Tag="60" Content="1 min" Style="{StaticResource Capsule}" Margin="5,0,0,0" Click="OnChip" />
                    <Button Tag="120" Content="2 min" Style="{StaticResource Capsule}" Margin="5,0,0,0" Click="OnChip" />
                </StackPanel>
                <Button x:Name="PhraseRow" Style="{StaticResource Plain}" Click="OnSettings" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,7,0">
                            <TextBlock Text="A" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                            <Rectangle Width="1.3" Height="12" Fill="{DynamicResource TextMuted}" Margin="2,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Unlock phrase" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource Fill2}" BorderBrush="{DynamicResource Stroke1}" BorderThickness="1" CornerRadius="6" Padding="7,1" Margin="7,0">
                            <TextBlock x:Name="PhraseText" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBody}" />
                        </Border>
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE70F;" FontSize="11" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border x:Name="LockedInfo" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="15"
                        Background="{DynamicResource Fill2}" BorderBrush="{DynamicResource Stroke1}" BorderThickness="1" Padding="12,5">
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="LockedInfoIcon" Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock x:Name="LockedInfoText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBody}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom bar: what's happening on the left, open-window (pop-up only) and settings on the right. -->
            <Grid Grid.Row="6" Height="45">
                <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource Stroke1}" />
                <DockPanel Margin="16,1,10,0" LastChildFill="True">
                    <Button x:Name="QuitButton" DockPanel.Dock="Right" Style="{StaticResource BarIcon}" Content="&#xE7E8;" Click="OnQuit" ToolTip="Quit Paws Off" />
                    <Button x:Name="GearButton" DockPanel.Dock="Right" Style="{StaticResource BarIcon}" Content="&#xE713;" Click="OnSettings" ToolTip="Settings" Margin="0,0,2,0" />
                    <Button x:Name="OpenWindowButton" DockPanel.Dock="Right" Style="{StaticResource BarIcon}" Content="&#xE8A7;" Click="OnOpenWindow"
                            ToolTip="Open the Paws Off window" Margin="0,0,2,0" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="BottomIcon" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <Path x:Name="BottomPaw" Data="{StaticResource PawGeometry}" Fill="{StaticResource BrandGradient}" Width="11" Height="11" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock x:Name="BottomText" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="210" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- Settings, inside the card at the same size: one compact row per setting. -->
        <Grid x:Name="SettingsPage" Visibility="Collapsed" Background="{DynamicResource WindowBackground}">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="SettingsSlide" X="320" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="45" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Style="{StaticResource Plain}" Click="OnSettingsDone" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" ToolTip="Back">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE76B;" FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,1,8,0" />
                    <TextBlock Text="Settings" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Border Grid.Row="1" Margin="12,0" CornerRadius="12" Background="{DynamicResource Fill1}" BorderBrush="{DynamicResource Stroke1}" BorderThickness="1" Padding="6,0">
                <StackPanel>
                    <Grid Height="40" Margin="10,0" Background="Transparent" ToolTip="Auto matches your Windows light or dark setting.">
                        <TextBlock Text="Appearance" Style="{StaticResource RowTitle}" />
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="2" CornerRadius="14" Background="{DynamicResource Fill1}"
                                BorderBrush="{DynamicResource Stroke1}" BorderThickness="1">
                            <StackPanel x:Name="ThemeButtons" Orientation="Horizontal">
                                <Button Tag="Auto" Content="Auto" Style="{StaticResource Capsule}" Padding="9,2" Click="OnThemeChoice" />
                                <Button Tag="Light" Content="Light" Style="{StaticResource Capsule}" Padding="9,2" Margin="2,0,0,0" Click="OnThemeChoice" />
                                <Button Tag="Dark" Content="Dark" Style="{StaticResource Capsule}" Padding="9,2" Margin="2,0,0,0" Click="OnThemeChoice" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Rectangle Height="1" Fill="{DynamicResource Stroke1}" Margin="10,0" />
                    <Grid Height="40" Margin="10,0" Background="Transparent"
                          ToolTip="Where Paws Off opens when it starts. Tray: the pop-up by the clock. Window: the window. Either way the other is one click away.">
                        <TextBlock Text="Start in" Style="{StaticResource RowTitle}" />
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="2" CornerRadius="14" Background="{DynamicResource Fill1}"
                                BorderBrush="{DynamicResource Stroke1}" BorderThickness="1">
                            <StackPanel x:Name="StartButtons" Orientation="Horizontal">
                                <Button Tag="Tray" Content="Tray" Style="{StaticResource Capsule}" Padding="9,2" Click="OnStartChoice" />
                                <Button Tag="Window" Content="Window" Style="{StaticResource Capsule}" Padding="9,2" Margin="2,0,0,0" Click="OnStartChoice" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Rectangle Height="1" Fill="{DynamicResource Stroke1}" Margin="10,0" />
                    <Grid Height="40" Margin="10,0" Background="Transparent"
                          ToolTip="Type it while locked to release the keyboard. Letters and numbers only; leave it empty to unlock by clicking.">
                        <TextBlock Text="Unlock phrase" Style="{StaticResource RowTitle}" />
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Width="110" Height="24" CornerRadius="7"
                                Background="{DynamicResource Fill2}" BorderBrush="{DynamicResource Stroke2}" BorderThickness="1" Padding="7,0">
                            <TextBox x:Name="PhraseBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBody}" VerticalAlignment="Center"
                                     CaretBrush="{DynamicResource TextBody}" FontFamily="Cascadia Mono, Consolas" FontSize="12" MaxLength="24"
                                     TextChanged="OnPhraseChanged" />
                        </Border>
                    </Grid>
                    <Rectangle Height="1" Fill="{DynamicResource Stroke1}" Margin="10,0" />
                    <Grid Height="40" Margin="10,0" Background="Transparent"
                          ToolTip="Locks by itself when several keys are pressed at once or held down, like a cat walking or sitting on the keyboard.">
                        <TextBlock Text="Paw detection" Style="{StaticResource RowTitle}" />
                        <CheckBox x:Name="PawSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnPawSwitch" />
                    </Grid>
                    <Rectangle Height="1" Fill="{DynamicResource Stroke1}" Margin="10,0" />
                    <Grid Height="40" Margin="10,0" Background="Transparent"
                          ToolTip="Starts quietly in the tray when you sign in, so the shortcut and paw detection are always ready.">
                        <TextBlock Text="Launch at sign-in" Style="{StaticResource RowTitle}" />
                        <CheckBox x:Name="LoginSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnLoginSwitch" />
                    </Grid>
                    <Rectangle Height="1" Fill="{DynamicResource Stroke1}" Margin="10,0" />
                    <Grid Height="40" Margin="10,0" Background="Transparent" ToolTip="Locks and unlocks from any app.">
                        <TextBlock Text="Shortcut" Style="{StaticResource RowTitle}" />
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="6" Background="{DynamicResource Fill2}"
                                BorderBrush="{DynamicResource Stroke2}" BorderThickness="1" Padding="7,2">
                            <TextBlock x:Name="ShortcutText" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBody}" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Grid.Row="3">
                <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource Stroke1}" />
                <DockPanel Margin="16,1,12,0" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Quit Paws Off" Style="{StaticResource Capsule}" VerticalAlignment="Center" Click="OnQuit" />
                    <TextBlock x:Name="CreditText" FontSize="11" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" />
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
