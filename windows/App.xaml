<Application x:Class="PawsOff.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">

    <!-- Shared by the app window and the tray pop-up. Colours come from Theme.cs (DynamicResource),
         applied app-wide so light and dark swap live everywhere. -->
    <Application.Resources>
        <FontFamily x:Key="AppFont">pack://application:,,,/Fonts/#Nunito</FontFamily>
        <FontFamily x:Key="Icons">Segoe MDL2 Assets</FontFamily>

        <!-- Paw print: four angled toes and a rounded pad (100x100 box). -->
        <GeometryGroup x:Key="PawGeometry" FillRule="Nonzero">
            <EllipseGeometry Center="17,45" RadiusX="9" RadiusY="12">
                <EllipseGeometry.Transform>
                    <RotateTransform Angle="-28" CenterX="17" CenterY="45" />
                </EllipseGeometry.Transform>
            </EllipseGeometry>
            <EllipseGeometry Center="36,24" RadiusX="9.5" RadiusY="13">
                <EllipseGeometry.Transform>
                    <RotateTransform Angle="-10" CenterX="36" CenterY="24" />
                </EllipseGeometry.Transform>
            </EllipseGeometry>
            <EllipseGeometry Center="64,24" RadiusX="9.5" RadiusY="13">
                <EllipseGeometry.Transform>
                    <RotateTransform Angle="10" CenterX="64" CenterY="24" />
                </EllipseGeometry.Transform>
            </EllipseGeometry>
            <EllipseGeometry Center="83,45" RadiusX="9" RadiusY="12">
                <EllipseGeometry.Transform>
                    <RotateTransform Angle="28" CenterX="83" CenterY="45" />
                </EllipseGeometry.Transform>
            </EllipseGeometry>
            <PathGeometry Figures="M50,50 C61,50 70,58 76,68 C81,77 79,88 69,90 C62,91.5 57,88 50,88 C43,88 38,91.5 31,90 C21,88 19,77 24,68 C30,58 39,50 50,50 Z" />
        </GeometryGroup>

        <!-- Sparkles (Clean): one large and two small four-point stars. -->
        <PathGeometry x:Key="SparkleGeometry"
                      Figures="M40,18 C46.8,45.2 46.8,45.2 74,52 C46.8,58.8 46.8,58.8 40,86 C33.2,58.8 33.2,58.8 6,52 C33.2,45.2 33.2,45.2 40,18 Z M78,4 C80.8,15.2 80.8,15.2 92,18 C80.8,20.8 80.8,20.8 78,32 C75.2,20.8 75.2,20.8 64,18 C75.2,15.2 75.2,15.2 78,4 Z M82,70 C84,78 84,78 92,80 C84,82 84,82 82,90 C80,82 80,82 72,80 C80,78 80,78 82,70 Z" />

        <!-- The app's own coral-to-violet, used for switches so they match the rest of the UI. -->
        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FA8C78" Offset="0" />
            <GradientStop Color="#C266FA" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="Plain" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextBody}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Capsule" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Background" Value="{DynamicResource Fill1}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Stroke1}" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 caption buttons; Close turns red on hover. -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Width="44" Height="36" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Fill2}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Width="44" Height="36" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small icon button with a round hover highlight (bottom bar). -->
        <Style x:Key="BarIcon" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Width="28" Height="28" CornerRadius="14" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Fill2}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBody}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle switch (track only). -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="38" Height="22" CornerRadius="11" Background="{DynamicResource Fill3}"
                                BorderBrush="{DynamicResource Stroke1}" BorderThickness="1">
                            <Ellipse x:Name="Knob" Width="16" Height="16" Fill="{DynamicResource SwitchKnob}" HorizontalAlignment="Left" Margin="2,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.25" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource BrandGradient}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="Transparent" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBody}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Application.Resources>
</Application>
